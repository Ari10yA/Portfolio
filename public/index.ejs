              <% mainProjects.forEach(project => { %>

              <div
                class="mb-project-card-wrapper"
                data-url="<%= project.url %>"
              >
                <div class="mb-projects-card">
                  <div class="mb-projects-card_imgcontainer">
                    <img
                      class="imgcontainer-img"
                      src="<%= project.image %>"
                      alt="<%= project.title %>"
                    />
                  </div>

                  <div class="mb-projects-card_details">

                    <div class="mb-projects-card_title">
                      <%= project.title %>
                    </div>

                    <div class="mb-projects-card_description">
                      <%= project.description %>
                    </div>

                    <div class="mb-projects-card_description2">
                      Show Project  <i class="fa-solid fa-arrow-up-right-from-square fa-icon-resize"></i>
