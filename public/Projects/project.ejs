<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="stylesheet" href="/main.css" />
    <link rel="stylesheet" href="/Projects/project.css" />
    <link rel="stylesheet" href="/menu.css" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Borel&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Tektur:wght@500&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Lugrasimo&family=Tektur:wght@500&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300&family=Croissant+One&family=Ubuntu&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
    />
    <title>Portfolio Website</title>
  </head>

  <body>
    <main>
      <div class="backdrop"></div>

      <%- include('../includes/main-header.ejs', {path: path}) %> <%-
      include('../includes/mobile-nav.ejs', {path: path}) %>

      <section class="main-body" id="main-body">
        <section class="mb-hero-section">
          <div class="mb-hero-details">
            <div class="mb-hero-head">
              <h1 class="mb-hero-header">projects.</h1>
              <span class="mb-hero-header2"
                >Here you will find some of the personal projects I created and
                for checking all projects check Github</span
              >
            </div>

            <div><a href="https://github.com/Ari10yA" class="fa fa-github"></a></div>
          </div>
        </section>

        <section class="mb-projects-section">
          <div class="mb-projects-container">
            <% projectsData?.forEach(project => { %>

  <div class="project-card">

    <div class="project-card-img">
      <img
        class="project-img"
        src="<%= project.image %>"
        alt="<%= project.title %>"
      />
    </div>

    <div class="project-details">

      <div class="project-head">
        <%= project.title %>
      </div>

      <div class="project-desc">
        <%= project.description %>
      </div>

      <div class="project-link">
        <a
          class="project-btn"
          href="<%= project.url %>"
          target="_blank"
          rel="noopener noreferrer"
        >
          Explore
        </a>
      </div>

    </div>

  </div>

<% }) %>
          </div>
        </section>
      </section>

      <%- include('../includes/footer.ejs') %>
    </main>

    <script src="../main.js"></script>
  </body>
</html>
